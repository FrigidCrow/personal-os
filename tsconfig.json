{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@personal-os/vnext-contracts": ["./packages/vnext-contracts/src/index.ts"],
      "@personal-os/vnext-domain": ["./packages/vnext-domain/src/index.ts"],
      "@personal-os/vnext-application": ["./packages/vnext-application/src/index.ts"],
      "@personal-os/vnext-infrastructure": ["./packages/vnext-infrastructure/src/index.ts"],
      "@personal-os/vnext-runtime": ["./packages/vnext-runtime/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "scripts/**/*.ts", "eslint.config.js", "vite.config.ts"]
}
