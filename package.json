{
  "name": "personal-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev -w @personal-os/server\" \"npm run dev -w @personal-os/web\"",
    "dev:server": "npm run dev -w @personal-os/server",
    "dev:web": "npm run dev -w @personal-os/web",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "seed": "npm run seed -w @personal-os/server",
    "start": "npm run start -w @personal-os/server",
    "healthcheck": "node scripts/healthcheck.mjs",
    "backup": "node scripts/backup-database.mjs",
    "privacy:cleanup": "node scripts/privacy-cleanup.mjs",
    "launchagent:install": "node scripts/install-launch-agents.mjs",
    "launchagent:uninstall": "node scripts/uninstall-launch-agents.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
